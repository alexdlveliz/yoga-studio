<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Nuevo estudiante | Yoga Studio</title><link rel="stylesheet" href="/static/styles.css"></head><body>
<aside class="demo-notice" aria-label="Demostración pública">Demostración pública de un trabajo académico. Todas las personas pueden editar los registros compartidos. Usa solo datos ficticios.</aside><header class="site-header"><a class="brand" href="/">Yoga Studio</a><span class="header-note">Estudiantes</span></header>
<main class="form-page"><a class="back-link" href="/students">← Volver a estudiantes</a><h1>Nuevo estudiante</h1><p class="form-intro">Agrega su nombre y teléfono.</p><% if(message){ %><p class="alert" role="alert"><%= message %></p><% } %><form action="/students" method="post" novalidate><input type="hidden" name="token" value="<%= token %>"><% if(errors.token){ %><p class="error" role="alert"><%= errors.token %></p><% } %><% if(errors.classChoice){ %><p class="error" role="alert"><%= errors.classChoice %></p><% } %>
<% for(const [name,label,type] of [['name','Nombre','text'],['phone','Teléfono','tel']]){ %><div class="field"><label for="<%= name %>"><%= label %></label><input id="<%= name %>" name="<%= name %>" type="<%= type %>" value="<%= values[name] %>" <%= errors[name]?'aria-invalid=true aria-describedby='+name+'-error':'' %>><% if(errors[name]){ %><p class="error" id="<%= name %>-error"><%= errors[name] %></p><% } %></div><% } %><div class="actions"><button class="primary" type="submit">Guardar estudiante</button><a href="/students">Cancelar</a></div></form></main></body></html>
