<% const editing = typeof studentId !== "undefined" && !!studentId; const locked = typeof readOnly !== "undefined" && readOnly; %>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= editing ? "Editar estudiante" : "Nuevo estudiante" %> | Yoga Studio</title><link rel="stylesheet" href="/static/styles.css"><script src="/static/form-submission.js" defer></script></head><body>
<aside class="demo-notice" aria-label="Demostración pública">Demostración pública de un trabajo académico. Todas las personas pueden editar los registros compartidos. Usa solo datos ficticios.</aside><header class="site-header"><a class="brand" href="/">Yoga Studio</a><span class="header-note">Estudiantes</span></header>
<main class="form-page"><a class="back-link" href="<%= editing ? "/students/"+studentId : "/students" %>">← Volver</a><h1><%= editing ? "Editar estudiante" : "Nuevo estudiante" %></h1><p class="form-intro">Agrega su nombre y teléfono.</p><% if(message){ %><p class="alert" role="alert"><%= message %></p><% } %><form action="<%= editing ? "/students/"+studentId : "/students" %>" method="post" data-pending-form><% if(!editing){ %><input type="hidden" name="token" value="<%= token %>"><% } %><% if(errors.token){ %><p class="error" role="alert"><%= errors.token %></p><% } %>
<% for(const [name,label,type] of [['name','Nombre','text'],['phone','Teléfono','tel']]){ %><div class="field"><label for="<%= name %>"><%= label %></label><input id="<%= name %>" name="<%= name %>" type="<%= type %>" value="<%= values[name] %>" required <%= errors[name]?'aria-invalid=true aria-describedby='+name+'-error':'' %>><% if(errors[name]){ %><p class="error" id="<%= name %>-error"><%= errors[name] %></p><% } %></div><% } %>
<% if(!editing){ %><fieldset class="field"><legend>Clases iniciales (opcional)</legend><% for(const [value,label] of [['none','Ninguna'],['1','1 clase'],['5','5 clases'],['10','10 clases'],['custom','Otra cantidad']]){ %><label class="choice"><input type="radio" name="classChoice" value="<%= value %>" <%= values.classChoice===value?'checked':'' %> <%= errors.classChoice?'aria-describedby=class-error':'' %>> <%= label %></label><% } %><label for="customCount">Otra cantidad de clases</label><input id="customCount" name="customCount" inputmode="numeric" value="<%= values.customCount %>"<% if(errors.classChoice && values.classChoice === "custom"){ %> aria-invalid="true" aria-describedby="class-error"<% } %>><% if(errors.classChoice){ %><p class="error" id="class-error"><%= errors.classChoice %></p><% } %></fieldset><% } %>
<div class="actions"><% if(!locked){ %><button class="primary" type="submit">Guardar estudiante</button><% } %><a href="<%= editing ? "/students/"+studentId : "/students" %>">Cancelar</a></div><p role="status" data-pending-status></p></form></main></body></html>
