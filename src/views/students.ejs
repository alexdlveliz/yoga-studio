<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Estudiantes | Yoga Studio</title><link rel="stylesheet" href="/static/styles.css"></head><body>
<aside class="demo-notice" aria-label="Demostración pública">Demostración pública de un trabajo académico. Todas las personas pueden editar los registros compartidos. Usa solo datos ficticios.</aside>
<header class="site-header"><a class="brand" href="/">Yoga Studio</a><span class="header-note">Estudiantes</span></header><main class="form-page">
<a class="back-link" href="/">← Volver al horario</a><div class="intro"><div><h1><%= status==='archived'?'Estudiantes archivados':'Estudiantes' %></h1><p class="form-intro">Busca a una persona por su nombre.</p></div><a class="button primary" href="/students/new">Nuevo estudiante</a></div>
<% if(notice){ %><p role="status"><%= notice %></p><% } %><form action="/students" method="get"><input type="hidden" name="status" value="<%= status %>"><div class="field"><label for="q">Buscar por nombre</label><input id="q" name="q" value="<%= q %>"></div><div class="actions"><button type="submit">Buscar</button><a href="/students<%= status==='archived'?'?status=archived':'' %>">Limpiar búsqueda</a></div></form>
<% if(students.length){ %><ul class="student-list"><% for(const student of students){ %><li><a href="/students/<%= student.id %>"><%= student.name %></a><span><%= student.phone %></span></li><% } %></ul><% }else{ %><p><%= q?'No se encontraron estudiantes para esta búsqueda.':'No hay estudiantes en esta lista.' %></p><% } %>
<p><a href="<%= status==='active'?'/students?status=archived':'/students' %>"><%= status==='active'?'Ver archivados':'Ver estudiantes activos' %></a></p></main></body></html>
