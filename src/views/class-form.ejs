<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= id ? 'Editar clase' : 'Nueva clase' %> | Yoga Studio</title><link rel="stylesheet" href="/static/styles.css"></head>
<body><header class="site-header"><a class="brand" href="/">Yoga Studio</a><span class="header-note">Horario del estudio</span></header><main class="form-page"><a class="back-link" href="/">← Volver al horario</a><h1><%= id ? 'Editar clase' : 'Nueva clase' %></h1><p class="form-intro">Completa los datos de la clase.</p><% if (message) { %><p class="alert" role="alert"><%= message %></p><% } %><form action="<%= id ? '/classes/'+id : '/classes' %>" method="post" novalidate><% if (!id) { %><input type="hidden" name="token" value="<%= token %>"><% if(errors.token){ %><p class="error"><%= errors.token %></p><% } } %>
<% const inputs=[['title','Título','text'],['date','Fecha','date'],['time','Hora','time'],['studentLimit','Límite de estudiantes','number']]; for (const [name,label,type] of inputs) { %><div class="field"><label for="<%= name %>"><%= label %></label><input id="<%= name %>" name="<%= name %>" type="<%= type %>" value="<%= values[name] %>" <%= name==='studentLimit'&&locked?'readonly':'' %> <%= errors[name]?'aria-invalid=true aria-describedby='+name+'-error':(name==='studentLimit'&&locked?'aria-describedby=studentLimit-help':'') %>><% if(name==='studentLimit'&&locked){ %><p id="studentLimit-help">El límite no se puede cambiar porque hay estudiantes inscritos o en espera.</p><% } %><% if(errors[name]){ %><p class="error" id="<%= name %>-error"><%= errors[name] %></p><% } %></div><% } %><div class="field"><label for="teacher">Profesora</label><select id="teacher" name="teacher" <%= errors.teacher?'aria-invalid=true aria-describedby=teacher-error':'' %>><option value="">Selecciona una profesora</option><% for(const teacher of ['Claudia','Ester']) { %><option value="<%= teacher %>" <%= values.teacher===teacher?'selected':'' %>><%= teacher %></option><% } %></select><% if(errors.teacher){ %><p class="error" id="teacher-error"><%= errors.teacher %></p><% } %></div><div class="actions"><button class="primary" type="submit">Guardar clase</button><a href="/">Cancelar</a></div></form></main></body></html>
