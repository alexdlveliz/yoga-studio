<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Agregar clases | Yoga Studio</title><link rel="stylesheet" href="/static/styles.css"><script src="/static/form-submission.js" defer></script></head><body>
<aside class="demo-notice" aria-label="Demostración pública">Demostración pública de un trabajo académico. Todas las personas pueden editar los registros compartidos. Usa solo datos ficticios.</aside><header class="site-header"><a class="brand" href="/">Yoga Studio</a><span class="header-note">Estudiantes</span></header><main class="form-page"><a class="back-link" href="/students/<%= student.id %>">← Volver al estudiante</a><h1>Agregar clases</h1><p><%= student.name %></p><% if(message){ %><p class="alert" role="alert"><%= message %></p><% } %>
<form action="/students/<%= student.id %>/classes" method="post" data-pending-form><input type="hidden" name="token" value="<%= token %>"><% if(errors.token){ %><p class="error" role="alert"><%= errors.token %></p><% } %><fieldset class="field"><legend>Cantidad de clases</legend><% for(const [value,label] of [['1','1 clase'],['5','5 clases'],['10','10 clases'],['custom','Otra cantidad']]){ %><label class="choice"><input type="radio" name="classChoice" value="<%= value %>" <%= values.classChoice===value?'checked':'' %> <%= errors.classChoice?'aria-describedby=class-error':'' %> required> <%= label %></label><% } %><label for="customCount">Otra cantidad de clases</label><input id="customCount" name="customCount" inputmode="numeric" value="<%= values.customCount %>"><% if(errors.classChoice){ %><p class="error" id="class-error"><%= errors.classChoice %></p><% } %></fieldset><div class="actions"><button class="primary" type="submit">Guardar clases</button><a href="/students/<%= student.id %>">Cancelar</a></div><p role="status" data-pending-status></p></form></main></body></html>
