<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Horario | Yoga Studio</title><link rel="stylesheet" href="/static/styles.css"></head><body><header class="site-header"><div class="brand"><span class="brand-mark" aria-hidden="true">✳</span> Yoga Studio</div><span class="header-note">Horario del estudio</span></header><main><div class="intro"><div><p class="context">Tu estudio, una semana a la vez</p><h1>Horario semanal</h1><p class="range"><%= format(week.dates[0],{month:'long',day:'numeric',year:'numeric'}) %> – <%= format(week.dates[6],{month:'long',day:'numeric',year:'numeric'}) %></p></div><nav aria-label="Semanas"><a href="/?week=<%= week.previous %>">← Semana anterior</a><a href="/?week=<%= week.next %>">Semana siguiente →</a><a class="primary" href="/classes/new">Nueva clase</a></nav></div><section class="calendar" aria-label="Horario de la semana"><div class="days"><% for(const day of week.dates){ %><div class="day"><span><%= format(day,{weekday:'short'}) %></span><time datetime="<%= day %>"><%= format(day,{month:'short',day:'numeric'}) %></time><% for(const item of classes.filter(c=>c.date===day)){ %><article class="class-card <%= !item.teacher?'missing-teacher':'' %>"><strong><%= item.title %></strong><p><%= item.time %></p><p><%= item.teacher || 'Sin profesora asignada' %></p><p>Límite: <%= item.student_limit %></p><a href="/classes/<%= item.id %>/edit">Editar</a></article><% } %></div><% } %></div><% if(!classes.length){ %><div class="empty"><span class="empty-symbol" aria-hidden="true">✳</span><h2>No hay clases esta semana</h2><p>No hay clases programadas para estas fechas.</p></div><% } %></section></main></body></html>
