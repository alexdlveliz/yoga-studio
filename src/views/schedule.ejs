<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Horario | Yoga Studio</title><link rel="stylesheet" href="/static/styles.css"></head>
<body><header class="site-header"><a class="brand" href="/">Yoga Studio</a><span class="header-note">Horario del estudio</span></header>
<main><div class="intro"><div><h1>Horario semanal</h1><p class="range"><%= format(week.dates[0],{month:'long',day:'numeric',year:'numeric'}) %> – <%= format(week.dates[6],{month:'long',day:'numeric',year:'numeric'}) %></p></div><nav aria-label="Semanas"><a class="button button-secondary" href="/?week=<%= week.previous %>">← Semana anterior</a><a class="button button-secondary" href="/?week=<%= week.next %>">Semana siguiente →</a><a class="button primary" href="/classes/new">Nueva clase</a></nav></div>
<section class="calendar <%= !classes.length ? 'calendar-empty' : '' %>" aria-label="Horario de la semana"><div class="days"><% for(const day of week.dates){ %><div class="day"><div class="day-heading"><span><%= format(day,{weekday:'long'}) %></span><time datetime="<%= day %>"><%= format(day,{month:'short',day:'numeric'}) %></time></div><% for(const item of classes.filter(c=>c.date===day)){ %><article class="class-card <%= !item.teacher?'missing-teacher':'' %>"><p class="class-time"><%= item.time %></p><strong><%= item.title %></strong><p><%= item.teacher || 'Sin profesora asignada' %></p><p>Límite: <%= item.student_limit %></p><a href="/classes/<%= item.id %>/edit">Editar <span aria-hidden="true">→</span></a></article><% } %></div><% } %></div><% if(!classes.length){ %><div class="empty"><h2>No hay clases esta semana</h2><p>No hay clases programadas para estas fechas.</p><a href="/classes/new">Crear una clase <span aria-hidden="true">→</span></a></div><% } %></section></main></body></html>
