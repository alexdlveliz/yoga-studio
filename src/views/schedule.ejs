<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Schedule | Yoga Studio</title><link rel="stylesheet" href="/static/styles.css"></head><body>
<header class="site-header"><div class="brand"><span class="brand-mark" aria-hidden="true">✳</span> Yoga Studio</div><span class="header-note">Studio schedule</span></header>
<main><div class="intro"><div><p class="context">Your studio, one week at a time</p><h1>Weekly schedule</h1><p class="range"><%= format(week.dates[0], {month:'long',day:'numeric',year:'numeric'}) %> – <%= format(week.dates[6], {month:'long',day:'numeric',year:'numeric'}) %></p></div><nav aria-label="Schedule weeks"><a href="/?week=<%= week.previous %>">← Previous week</a><a href="/?week=<%= week.next %>">Next week →</a></nav></div>
<section class="calendar" aria-label="Week at a glance"><div class="days"><% for (const day of week.dates) { %><div class="day"><span><%= format(day,{weekday:'short'}) %></span><time datetime="<%= day %>"><%= format(day,{month:'short',day:'numeric'}) %></time></div><% } %></div><div class="empty"><span class="empty-symbol" aria-hidden="true">✳</span><h2>No classes this week</h2><p>There are no classes on the schedule for these dates.</p></div></section></main></body></html>
