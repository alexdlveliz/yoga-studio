# Server only. Copy provider connection strings; percent-encode password characters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Setup and manual backup/restore: use the session pooler or direct connection.
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# Optional PEM CA certificate if required for verified TLS; never disable verification.
# DATABASE_CA_CERT=
STUDIO_LOCALE=es-GT
STUDIO_TIMEZONE=America/Guatemala
